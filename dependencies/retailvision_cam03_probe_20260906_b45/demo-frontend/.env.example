# Local FastAPI read API and camera Push receiver.
VITE_API_BASE_URL=http://localhost:8081

# Isolated camera-only Demo greeting control service. This service starts the
# RTSP worker but only real camera motion can create a Demo behaviour event.
VITE_DEMO_GREETING_BASE_URL=http://127.0.0.1:8082

# Optional: retain same-origin /api requests through the Vite dev proxy.
# VITE_API_PROXY_TARGET=http://127.0.0.1:8081
